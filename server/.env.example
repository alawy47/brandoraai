# --- Default providers: Claude (text) and Gemini (text fallback, images, photo mockups) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional extra provider (not used unless you list it in the *_PROVIDERS variables below)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Vectorising (Potrace works without a key) ---
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
VECTORIZER_MODE=production

# --- Fonts (optional; the curated library is used without it) ---
GOOGLE_FONTS_API_KEY=

# --- Routing: provider order per task ---
TEXT_PROVIDERS=anthropic,gemini
IMAGE_PROVIDERS=gemini
EDIT_PROVIDERS=gemini
VECTOR_PROVIDERS=vectorizer,potrace

# --- Reliability and limits ---
PROVIDER_RETRIES=2
JOB_CONCURRENCY=2
RATE_LIMIT_PER_MIN=20

# --- Cost estimates (USD). Claude defaults to 4 / 20 per million tokens. ---
PRICE_OPENAI_INPUT_MTOK=
PRICE_OPENAI_OUTPUT_MTOK=
PRICE_OPENAI_IMAGE=
PRICE_GEMINI_INPUT_MTOK=
PRICE_GEMINI_OUTPUT_MTOK=
PRICE_GEMINI_IMAGE=
PRICE_VECTORIZER_IMAGE=

# --- Auth + usage logging (Supabase, optional in development) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=8787
CORS_ORIGIN=http://localhost:5173
